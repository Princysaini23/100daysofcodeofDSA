#include <stdio.h>

#define MAX 100

int dq[MAX];
int front = -1, rear = -1;

int isEmpty() {
    return front == -1;
}

int isFull() {
    return (rear + 1) % MAX == front;
}

void push_front(int x) {
    if (isFull()) {
        printf("Deque Overflow\n");
        return;
    }

    if (isEmpty()) {
        front = rear = 0;
    } else {
        front = (front - 1 + MAX) % MAX;
    }

    dq[front] = x;
}

void push_back(int x) {
    if (isFull()) {
        printf("Deque Overflow\n");
        return;
    }

    if (isEmpty()) {
        front = rear = 0;
    } else {
        rear = (rear + 1) % MAX;
    }

    dq[rear] = x;
}

void pop_front() {
    if (isEmpty()) {
        printf("-1\n");
        return;
    }

    printf("%d\n", dq[front]);

    if (front == rear) {
        front = rear = -1;
    } else {
        front = (front + 1) % MAX;
    }
}

void pop_back() {
    if (isEmpty()) {
        printf("-1\n");
        return;
    }

    printf("%d\n", dq[rear]);

    if (front == rear) {
        front = rear = -1;
    } else {
        rear = (rear - 1 + MAX) % MAX;
    }
}

void show_front() {
    if (isEmpty())
        printf("-1\n");
    else
        printf("%d\n", dq[front]);
}

void show_back() {
    if (isEmpty())
        printf("-1\n");
    else
        printf("%d\n", dq[rear]);
}

int size() {
    if (isEmpty())
        return 0;

    if (rear >= front)
        return rear - front + 1;

    return MAX - front + rear + 1;
}

int main() {

    push_back(10);
    push_back(20);
    push_front(5);

    show_front();  // 5
    show_back();   // 20

    pop_front();   // remove 5
    pop_back();    // remove 20

    printf("Size: %d\n", size());

    return 0;
}