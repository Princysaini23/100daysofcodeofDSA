#include <stdio.h>

int pq[100];
int size = 0;

void insert(int x){
    pq[size++] = x;
}

int delete(){
    if(size == 0)
        return -1;

    int minIndex = 0;

    for(int i=1;i<size;i++){
        if(pq[i] < pq[minIndex])
            minIndex = i;
    }

    int val = pq[minIndex];

    for(int i=minIndex;i<size-1;i++){
        pq[i] = pq[i+1];
    }

    size--;

    return val;
}

int peek(){
    if(size == 0)
        return -1;

    int min = pq[0];

    for(int i=1;i<size;i++){
        if(pq[i] < min)
            min = pq[i];
    }

    return min;
}

int main(){

    int n;
    scanf("%d",&n);

    for(int i=0;i<n;i++){
        char op[10];
        scanf("%s",op);

        if(op[0]=='i'){
            int x;
            scanf("%d",&x);
            insert(x);
        }
        else if(op[0]=='d'){
            printf("%d\n",delete());
        }
        else if(op[0]=='p'){
            printf("%d\n",peek());
        }
    }

    return 0;
}